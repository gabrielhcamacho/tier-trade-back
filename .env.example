NODE_ENV=development
AUTH_MODE=development
PORT=3001
DATABASE_URL=postgresql://tier_trade_runtime:tier_trade_runtime@localhost:5432/tier_trade
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
SUPABASE_URL=
